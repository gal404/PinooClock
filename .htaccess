# Pretty defaults — no rewrites required, app uses real .php URLs.
DirectoryIndex index.php

# Block access to dotfiles & SQLite files at the web root just in case.
<FilesMatch "^\.|\.(sqlite|db|db-journal|db-wal|db-shm)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
